# Copy to .env — never commit the real file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://inkwell:inkwell@localhost:5432/inkwell
# Unset = single node. Set to run several sync nodes (see docker-compose.cluster.yml).
REDIS_URL=
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:4000

# GitHub OAuth app (https://github.com/settings/developers), callback: ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local-only passwordless login for development/tests. The server refuses to boot with this in production.
ENABLE_DEV_LOGIN=true
