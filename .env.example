# Copy to .env — never commit the real file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://inkwell:inkwell@localhost:5432/inkwell
# Unset = single node. Set to run several sync nodes (see docker-compose.cluster.yml).
REDIS_URL=
WEB_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:4000

# GitHub OAuth app (https://github.com/settings/developers), callback: ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local-only passwordless login for development/tests. The server refuses to boot with this in production.
ENABLE_DEV_LOGIN=true

# --- AI collaborator (only read when AI_FEATURES=true; leave unset for the normal version) ---
AI_FEATURES=false
# Any OpenAI-compatible endpoint; Groq by default. Keys come from the server environment only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Web search for the Expand mode (Tavily).
TAVILY_API_KEY=
# Safeguards (defaults shown): comma-separated invite list (empty = any signed-in editor),
# per-user rate limits, global daily token budget on the shared key (0 = off), per-request budgets.
AI_ALLOWED_EMAILS=
AI_RATE_PER_MINUTE=4
AI_RATE_PER_DAY=60
AI_DAILY_TOKEN_BUDGET=300000
AI_REQUEST_TOKEN_BUDGET=6000
AI_EXPAND_TOKEN_BUDGET=40000
AI_MAX_STEPS=8
