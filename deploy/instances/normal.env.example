# Instance: the NORMAL version (no AI features).
# Copy to deploy/instances/normal.env, fill in the blanks and never commit the copy (git-ignored).
# Check it before use:  node deploy/check-instance.mjs deploy/instances/normal.env

INSTANCE=normal
# Host port nginx listens on. Put TLS in front of it (hosting platform / load balancer).
HTTP_PORT=8080

# The one public address people use. The four URLs below must agree (the checker verifies it).
WEB_ORIGIN=https://inkwell.example.com
PUBLIC_URL=https://inkwell.example.com/api
NEXT_PUBLIC_API_URL=https://inkwell.example.com/api
NEXT_PUBLIC_WS_URL=wss://inkwell.example.com/ws

# Feature flags: this is the normal version, so both are false. No AI route exists and no LLM or
# search key is read. (The web flag is compiled into the web image at build time.)
AI_FEATURES=false
NEXT_PUBLIC_AI_FEATURES=false

# GitHub OAuth app for THIS instance. Callback URL: <PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# This instance's own database (URL-safe characters only: letters, digits, . _ ~ -).
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=
POSTGRES_DB=inkwell_normal

# Optional. Error tracking is off unless a DSN is set.
SENTRY_DSN=
