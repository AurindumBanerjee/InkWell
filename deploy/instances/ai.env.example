# Instance: the AI version (same codebase, AI collaborator switched on).
# Copy to deploy/instances/ai.env, fill in the blanks and never commit the copy (git-ignored).
# Check it before use:  node deploy/check-instance.mjs deploy/instances/ai.env
# Standing it up is described in docs/deploy.md ("Second instance"). Do not create it until the
# owner has agreed to the accounts, keys and public address it needs.

INSTANCE=ai
# A different host port from the normal instance if both run on one machine.
HTTP_PORT=8081

# A different public address from the normal instance (its own host name, or its own port).
WEB_ORIGIN=https://ai.inkwell.example.com
PUBLIC_URL=https://ai.inkwell.example.com/api
NEXT_PUBLIC_API_URL=https://ai.inkwell.example.com/api
NEXT_PUBLIC_WS_URL=wss://ai.inkwell.example.com/ws

# Feature flags: both true in this version. They must agree (the checker verifies it).
AI_FEATURES=true
NEXT_PUBLIC_AI_FEATURES=true

# A separate GitHub OAuth app: its callback URL differs from the normal instance.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Its own database, so the two instances never share data.
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=
POSTGRES_DB=inkwell_ai

# Server-side provider keys for the AI collaborator. Read only because AI_FEATURES=true; never
# exposed to the browser or logged. Leave blank to run with no model configured.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SEARCH_API_KEY=

# AI-instance safeguards (invite-only sign-in, per-user rate limit, global daily token budget,
# optional bring-your-own-key) are configured here when the AI collaborator is built.

# Optional. Error tracking is off unless a DSN is set.
SENTRY_DSN=
