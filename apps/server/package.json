{
  "name": "@inkwell/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx --env-file=../../.env src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev:db": "tsx scripts/dev-db.ts",
    "cluster:demo": "tsx scripts/cluster-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.0.0",
    "ioredis": "^6.0.0",
    "lib0": "^0.2.119",
    "pg": "^8.13.0",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.3",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
