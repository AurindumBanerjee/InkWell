{
  "name": "inkwell",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w apps/server -w apps/web",
    "test": "npm run test -w apps/server",
    "dev:db": "npm run dev:db -w apps/server",
    "dev:api": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0"
  },
  "overrides": {
    "cookie": "^1.0.2"
  },
  "type": "module"
}
